<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Each restricted field is duplicated:
        - the original one is kept for the creator group;
        - a copy with no_create is added for everybody else (groups="!...").
        The copies reproduce the field definitions of sale, sale_product_configurator
        and sale_management (Odoo 16). High priority so that they are applied after
        the other inheriting views.
    -->
    <record id="view_order_form_restrict_creation" model="ir.ui.view">
        <field name="name">sale.order.form.restrict.creation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Customer -->
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="attributes">
                <attribute name="groups">juliennejavel_restrict_creation.group_contact_and_product_creator</attribute>
            </xpath>
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="partner_id"
                    groups="!juliennejavel_restrict_creation.group_contact_and_product_creator"
                    widget="res_partner_many2one"
                    context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                    options='{"always_reload": True, "no_create": True}'/>
            </xpath>

            <!-- Order lines: line form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="groups">juliennejavel_restrict_creation.group_contact_and_product_creator</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="product_id"
                    groups="!juliennejavel_restrict_creation.group_contact_and_product_creator"
                    domain="[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    context="{'partner_id':parent.partner_id, 'quantity':product_uom_qty, 'pricelist':parent.pricelist_id, 'uom':product_uom, 'company_id': parent.company_id}"
                    attrs="{
                        'readonly': [('product_updatable', '=', False)],
                        'required': [('display_type', '=', False)],
                    }"
                    force_save="1"
                    widget="many2one_barcode"
                    options="{'no_create': True}"/>
            </xpath>

            <!-- Order lines: list, product variant -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                <attribute name="groups">juliennejavel_restrict_creation.group_contact_and_product_creator</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="product_id"
                    groups="!juliennejavel_restrict_creation.group_contact_and_product_creator"
                    string="Product Variant"
                    optional="hide"
                    attrs="{
                        'readonly': [('product_updatable', '=', False)],
                        'required': [('display_type', '=', False)],
                    }"
                    force_save="1"
                    context="{
                        'partner_id': parent.partner_id,
                        'quantity': product_uom_qty,
                        'pricelist': parent.pricelist_id,
                        'uom':product_uom,
                        'company_id': parent.company_id,
                        'default_lst_price': price_unit,
                        'default_description_sale': name
                    }"
                    options="{'no_open': True, 'no_create': True}"
                    domain="[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    widget="sol_product_many2one"/>
            </xpath>

            <!-- Order lines: list, product template -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="attributes">
                <attribute name="groups">juliennejavel_restrict_creation.group_contact_and_product_creator</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="after">
                <field name="product_template_id"
                    groups="!juliennejavel_restrict_creation.group_contact_and_product_creator"
                    string="Product"
                    attrs="{
                        'readonly': [('product_updatable', '=', False)],
                        'required': [('display_type', '=', False)],
                    }"
                    context="{
                        'partner_id': parent.partner_id,
                        'quantity': product_uom_qty,
                        'pricelist': parent.pricelist_id,
                        'uom':product_uom,
                        'company_id': parent.company_id,
                        'default_list_price': price_unit,
                        'default_description_sale': name
                    }"
                    options="{'no_open': True, 'no_create': True}"
                    domain="[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    widget="sol_product_many2one"/>
            </xpath>

            <!-- Optional products (sale_management): form -->
            <xpath expr="//field[@name='sale_order_option_ids']/form//field[@name='product_id']" position="attributes">
                <attribute name="groups">juliennejavel_restrict_creation.group_contact_and_product_creator</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_option_ids']/form//field[@name='product_id']" position="after">
                <field name="product_id"
                    groups="!juliennejavel_restrict_creation.group_contact_and_product_creator"
                    domain="[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    options="{'no_create': True}"/>
            </xpath>

            <!-- Optional products (sale_management): list -->
            <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="groups">juliennejavel_restrict_creation.group_contact_and_product_creator</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='product_id']" position="after">
                <field name="product_id"
                    groups="!juliennejavel_restrict_creation.group_contact_and_product_creator"
                    domain="[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    options="{'no_create': True}"/>
            </xpath>

        </field>
    </record>
</odoo>
