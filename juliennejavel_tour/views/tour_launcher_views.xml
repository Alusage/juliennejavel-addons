<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vue formulaire pour le lanceur de tour -->
        <record id="view_tour_launcher_form" model="ir.ui.view">
            <field name="name">bet.tour.launcher.form</field>
            <field name="model">bet.tour.launcher</field>
            <field name="arch" type="xml">
                <form>
                    <div class="alert alert-info" role="alert">
                        <h4><i class="fa fa-info-circle"/> Visite guidée BET</h4>
                        <p>Découvrez les fonctionnalités du module Julienne Javel Base avec nos visites guidées interactives.</p>
                    </div>
                    <group>
                        <field name="tour_name" widget="radio"/>
                    </group>
                    <div class="mt-3">
                        <h5>Descriptions des tours :</h5>
                        <ul>
                            <li><strong>Tour Simple BET</strong> : Présentation rapide des fonctionnalités (2 minutes)</li>
                            <li><strong>Tour Avancé BET</strong> : Découverte détaillée du module (5 minutes)</li>
                        </ul>
                    </div>
                    <footer>
                        <button name="launch_tour" type="object" string="🚀 Démarrer le tour" class="btn-primary"/>
                        <button special="cancel" string="Annuler" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action pour ouvrir le lanceur de tour -->
        <record id="action_tour_launcher" model="ir.actions.act_window">
            <field name="name">Visite guidée BET</field>
            <field name="res_model">bet.tour.launcher</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_tour_launcher_form"/>
        </record>

        <!-- Action client pour démarrer directement le tour avancé -->
        <record id="action_start_advanced_tour" model="ir.actions.client">
            <field name="name">Tour Avancé BET</field>
            <field name="tag">simple_tour_launcher</field>
            <field name="params">{"tour_name": "bet_advanced_tour"}</field>
        </record>

        <!-- Action client pour démarrer le tour simple -->
        <record id="action_start_simple_tour" model="ir.actions.client">
            <field name="name">Tour Simple BET</field>
            <field name="tag">simple_tour_launcher</field>
            <field name="params">{"tour_name": "bet_simple_tour"}</field>
        </record>

    </data>
</odoo>
