<odoo>
    <data>
        <!-- Inherit the form view of sale.order -->
        <record id="view_order_form_inherited" model="ir.ui.view">
            <field name="name">sale.order.form.inherited</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
            <field name="arch" type="xml">
                <!-- Ajouter le bouton "Créer devis TZEE" dans l'en-tête -->
                <xpath expr="//header" position="inside">
                    <button name="create_tzee_order" 
                            type="object" 
                            string="Créer devis TZEE" 
                            class="oe_highlight"
                            groups="sale_management.group_sale_order_template"
                            attrs="{'invisible': ['|', ('sale_order_template_id', '!=', 2), ('devis_tzee_id', '!=', False)]}"/>
                    <button name="action_view_tzee_order" 
                            type="object" 
                            string="Voir devis TZEE" 
                            class="btn-secondary"
                            groups="sale_management.group_sale_order_template"
                            attrs="{'invisible': ['|', ('sale_order_template_id', '!=', 2), ('devis_tzee_id', '=', False)]}"/>
                </xpath>
                
                <field name="sale_order_template_id" position="after">
                        <field name="fiscal_revenue"/>
                        <field name="devis_tzee_id" 
                               groups="sale_management.group_sale_order_template"
                               attrs="{'invisible': [('sale_order_template_id', '!=', 2)]}"/>
                        <field name="client_tzee_id" 
                               groups="sale_management.group_sale_order_template"
                               attrs="{'invisible': [('sale_order_template_id', '!=', 3)]}"/>
                        <field name="order_state_id"/>
                </field>
                <notebook position="inside">
                    <page string="Informations Dossier">
                        <group>
                            <field name="energy_gain"/>
                            <field name="total_work_cost"/>
                            <field name="total_subsidies"/>
                            <field name="financing_rate"/>
                            <field name="delegataire_id"/>
                            <field name="procivis_file"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="view_sale_order_kanban_inherited" model="ir.ui.view">
            <field name="name">sale.order.kanban.inherited</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
            <field name="arch" type="xml">
                    <xpath expr="//kanban" position="attributes">
                        <attribute name="default_group_by">order_state_id</attribute>
                    </xpath>
                    <field name="state" position="after">
                        <field name="order_state_id" options='{"group_by_tooltip": {"description": "Description"}}'/>
                        <field name="color"/>
                    </field>
                    <!-- Ajouter une classe CSS dynamique pour la couleur -->
                    <xpath expr="//div[@t-attf-class='oe_kanban_card oe_kanban_global_click']" position="attributes">
                        <attribute name="t-attf-class">oe_kanban_card oe_kanban_global_click oe_kanban_color_border_{{record.color.raw_value or 0}}</attribute>
                    </xpath>
                    <xpath expr="//div[@class='o_kanban_record_bottom']" position="before">
                        <div class="o_kanban_record_body">
                            <strong>Modèle: </strong><field name="sale_order_template_id"/>
                        </div>
                    </xpath>
            </field>
        </record>

        <record id="view_sales_order_filter_inherited" model="ir.ui.view">
            <field name="name">sale.order.filter.inherited</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Jalon" name="order_state_id" domain="[]" context="{'group_by': 'order_state_id'}"/>
            </xpath>
            </field>
        </record>

        <!-- Inherit the tree view of sale.order.line to add force_invoicing field -->
        <record id="view_order_line_tree_inherited" model="ir.ui.view">
            <field name="name">sale.order.line.tree.inherited</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_tree"/>
            <field name="arch" type="xml">
                <field name="qty_invoiced" position="after">
                    <field name="force_invoicing" optional="hide"/>
                </field>
            </field>
        </record>

        <!-- Inherit the form view of sale.order to add force_invoicing in order_line -->
        <record id="view_order_form_order_line_inherited" model="ir.ui.view">
            <field name="name">sale.order.form.order.line.inherited</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree//field[@name='qty_invoiced']" position="after">
                    <field name="force_invoicing" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>