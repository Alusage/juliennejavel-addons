
<odoo>

<record id="sale_order_import_form" model="ir.ui.view">
    <field name="name">sale.order.import.import.form</field>
    <field name="model">sale.order.import</field>
    <field name="arch" type="xml">
        <form>
            <group name="main">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="file_to_import" filename="filename"/>
                <field name="filename" invisible="1"/>
            </group>
            <!--
            <div name="info-xlsx" invisible="file_format != 'genericxlsx'">
                <h3>Columns of the Generic XLSX format</h3>
                    <p>
                    A. Nom de l'employé<br/>
                    B. Type de congés<br/>
                    C. Description<br/>
                    D. Temps alloué<br/>
                </p>
            </div>
            -->
            <footer>
                <button name="run_import" type="object" string="Import" class="btn-primary" />
                <button special="cancel" string="Cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="sale_order_import_action" model="ir.actions.act_window">
    <field name="name">Import sale_orders</field>
    <field name="res_model">sale.order.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<menuitem id="sale_order_import_menu"
        parent="sale.menu_sale_config"
        action="sale_order_import_action"
        sequence="150" />

</odoo>
