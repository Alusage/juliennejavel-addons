
<odoo>

<record id="sale_order_import_contact_form" model="ir.ui.view">
    <field name="name">sale.order.import.contact.form</field>
    <field name="model">sale.order.import.contact</field>
    <field name="arch" type="xml">
        <form>
            <group name="main">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="file_to_import" filename="filename"/>
                <field name="filename" invisible="1"/>
            </group>
            
            <footer>
                <button name="run_import" type="object" string="Import" class="btn-primary" />
                <button special="cancel" string="Cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="sale_order_import_contact_action" model="ir.actions.act_window">
    <field name="name">Import Contact</field>
    <field name="res_model">sale.order.import.contact</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<menuitem id="sale_order_contact_import_menu"
        parent="sale.menu_sale_config"
        action="sale_order_import_contact_action"
        sequence="150"
        active="False" />

</odoo>
